{
  "name": "sure-commerce-group",
  "main": "src/index.js",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    { "name": "CONTACT_EMAIL", "destination_address": "info@commerce-group.co.uk" }
  ]
}
